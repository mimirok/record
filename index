        <input id="l_file" type="file" accept="image/*" onchange="appHandleImgUpload(event)">
        <input id="l_img_data" type="hidden">
        <div id="img_preview_box" style="margin-top:4px"></div>

        <label style="margin-top:8px">📝 비고 (균사 색상, 냄새, 포대 관리 등)</label>
