          <div class="log">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <div>
                <b>${l.d}</b> <span class="mute">D+${dayN(b.start, l.d)}</span>${l.vent ? '<span class="tag" style="background:var(--c4)">🌀 환기/뒤집음</span>' : ''}
              </div>
              <div class="no-print">
                <button type="button" class="edit-btn" onclick="appEditNurukLog('${l.d}')">수정</button>
                <button type="button" class="g" style="color:#d9534f" onclick="appDelLog('${l.d}')">삭제</button>
              </div>
            </div>
            <div class="mute" style="margin:4px 0 2px">
              ${[
                l.temp !== '' && '품온 ' + l.temp + '°C',
                l.room !== '' && '실온 ' + l.room + '°C',
                (l.hum !== '' && l.hum != null) && '습도 ' + l.hum + '%'
              ].filter(Boolean).join(' · ')}
            </div>
            <div>${esc(l.note)}</div>${l.img ? `<img src="${l.img}" class="log-img" alt="누룩 사진" onclick="window.open(this.src)">` : ''}
          </div>
        `).join('') : '<div class="mute" style="margin-top:8px">기록된 일지가 없습니다.</div>'}
      </div>
    `;
  }

  // 💡 [개선 완료] 전통주 주방문(배합비) 화면
  function wineRecipeView(b){
    if(!b.stages) b.stages = [];
    const g = tot(b, 'grain'), n = tot(b, 'nuruk'), w = tot(b, 'water'), T = all(b);
    const tg = b.target || {};
    const targetNurukPct = tg.nurukRatio != null ? tg.nurukRatio : 10.0;
    const targetWaterPct = tg.waterRatio != null ? tg.waterRatio : 100.0;

    const rows = WINE_CATS.map(c => {
      const a = tot(b, c.k);
      return `<tr>
        <td><span class="dot" style="background:${c.col}"></span>${c.n}</td>
        <td>${f(a, 0)}g</td>
        <td>${g ? (a / g).toFixed(2) : '-'}</td>
        <td>${g ? (a / g * 100).toFixed(1) + '%' : '-'}</td>
        <td>${T ? f(a / T * 100, 1) + '%' : '-'}</td>
      </tr>`;
    }).join('');

    const bar = T ? `<div class="bar">${WINE_CATS.map(c => `<div style="width:${tot(b, c.k) / T * 100}\%;background:${c.col}"></div>`).join('')}</div>` : '';

    const stagesHtml = b.stages.map((stg, sIdx) => {
      const itemsHtml = (stg.items && stg.items.length) ? stg.items.map((item, iIdx) => {
        const catInfo = WINE_CATS.find(c => c.k === item.cat) || WINE_CATS[0];
        return `
          <div class="item">
            <span><span class="dot" style="background:${catInfo.col}"></span>[${catInfo.n}] <b>${esc(item.name)}</b></span>
            <span>${item.amt}g <button type="button" class="g no-print" onclick="appDelStageItem(${sIdx}, ${iIdx})">✕</button></span>
          </div>
        `;
      }).join('') : '<div class="mute" style="font-size:12px;padding:4px 0">투입된 원료가 없습니다.</div>';

      return `
        <div class="stage-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <h3 style="margin:0;font-size:15px;color:var(--acc)">🍶 ${esc(stg.name)}</h3>
            <button type="button" class="g no-print" style="color:#d9534f" onclick="appDelStage(${sIdx})">단계 삭제</button>
          </div>

          <div class="row" style="margin-bottom:8px">
            <div style="flex:1">
              <label>📅 ${esc(stg.name)} 담금 일자</label>
              <input type="date" value="${stg.date || today()}" onchange="appSetStageDate(${sIdx}, this.value)">
            </div>
            <div style="flex:1;font-size:12px;color:var(--mute);padding-bottom:10px">
              시작 대비: <b>D+${dayN(b.start, stg.date || b.start)}</b>
            </div>
          </div>
          
          <div style="margin-bottom:10px">${itemsHtml}</div>

          <div class="row no-print" style="background:var(--bg);padding:8px;border-radius:8px">
            <div style="flex:1">
              <label>분류</label>
              <select id="stg_cat_${sIdx}">
                ${WINE_CATS.map(c => `<option value="${c.k}">${c.ic}${c.n}</option>`).join('')}
              </select>
            </div>
            <div style="flex:2">
              <label>원료명</label>
              <input id="stg_name_${sIdx}" placeholder="예: 멥쌀 범벅">
            </div>
            <div style="flex:1">
              <label>양(g)</label>
              <input id="stg_amt_${sIdx}" type="number" placeholder="g">
            </div>
            <div style="flex:0 0 auto">
              <button type="button" class="p" onclick="appAddStageItem(${sIdx})">추가</button>
            </div>
          </div>

          <label style="margin-top:10px">📝 ${esc(stg.name)} 비고 (전처리, 찌기, 식힘 등)</label>
          <textarea id="stg_note_${sIdx}" rows="2" placeholder="작업 메모를 남겨두세요">${esc(stg.note || '')}</textarea>
          <button type="button" class="no-print" style="width:100%;margin-top:6px;font-size:12px" onclick="appSaveStageNote(${sIdx})">비고 저장</button>
        </div>
      `;
    }).join('');

    const targetNurukAmt = g * (targetNurukPct / 100);
    const targetWaterAmt = g * (targetWaterPct / 100);

    return `
      <div class="card">
        <b>📊 전체 누적 배합 비율 (합계)</b>
        ${bar}
        <table>
          <tr><th>항목</th><th>총 투입량</th><th>곡물 1 대비</th><th>곡물 대비 %</th><th>전체 중 비중</th></tr>
          ${rows}
          <tr class="tot"><td>총합</td><td>${f(T, 0)}g</td><td>${g ? (T / g).toFixed(2) : '-'}</td><td>-</td><td>100%</td></tr>
        </table>
        <div class="big">${brief(b)}</div>
        <div class="mute">
          누룩 비율: <b>${g ? (n / g * 100).toFixed(1) : '-'}%</b> (곡물 대비) · 
          물 비율(가수율): <b>${g ? (w / g * 100).toFixed(1) : '-'}%</b> (곡물 대비)
        </div>
      </div>

      <div class="card">
        <b>🎯 목표 배합비 점검 (곡물 1 기준)</b>
        <div class="mute">현재 총 곡물량 (<b>${f(g, 0)}g</b>)을 1(100%)로 두고 목표량을 계산합니다.</div>
        
        <div class="row no-print" style="margin-top:8px">
          <div>
            <label>목표 누룩 비율 (곡물 대비 %)</label>
            <input id="t_nr" type="number" step="0.5" value="${targetNurukPct}">
          </div>
          <div>
            <label>목표 물 비율 / 가수율 (곡물 대비 %)</label>
            <input id="t_wr" type="number" step="0.5" value="${targetWaterPct}">
          </div>
          <div style="flex:0 0 auto">
            <button type="button" class="p" onclick="appSaveTarget()">목표 저장</button>
          </div>
        </div>

        <table style="margin-top:10px">
          <tr><th>원료</th><th>목표 기준</th><th>목표 필요량</th><th>현재 누적량</th><th>상태 (조정 필요량)</th></tr>
          <tr>
            <td>누룩</td>
            <td>${targetNurukPct}%</td>
            <td>${f(targetNurukAmt, 0)}g</td>
            <td>${f(n, 0)}g</td>
            <td>${diff(n, targetNurukAmt, 'g')}</td>
          </tr>
          <tr>
            <td>물 (가수량)</td>
            <td>${targetWaterPct}%</td>
            <td>${f(targetWaterAmt, 0)}g</td>
            <td>${f(w, 0)}g</td>
            <td>${diff(w, targetWaterAmt, 'g')}</td>
          </tr>
        </table>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;margin:16px 0 8px">
        <h2 style="margin:0">🪜 담금 단계 레이어 (단양주/이양주/삼양주)</h2>
        <button type="button" class="p no-print" onclick="appAddStage()">+ 덧술 단계 추가</button>
      </div>

      ${stagesHtml || '<div class="card mute">단계를 추가해 주세요. (밑술부터 시작)</div>'}
    `;
  }

  // 💡 [개선 완료] 전통주 발효일지 화면
