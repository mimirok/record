          return `
            <div class="log">
              <div style="display:flex;justify-content:space-between;align-items:center">
                <div>
                  <b>${l.d}</b> <span class="mute">D+${dayN(b.start, l.d)}</span>${badgeHtml}
                </div>
                <div class="no-print">
                  <button type="button" class="edit-btn" onclick="appEditWineLog('${l.d}')">수정</button>
                  <button type="button" class="g" style="color:#d9534f" onclick="appDelLog('${l.d}')">삭제</button>
                </div>
              </div>
              <div class="mute" style="margin:4px 0 2px">
                ${[
                  l.temp !== '' && '품온 ' + l.temp + '°C',
                  l.room !== '' && '실온 ' + l.room + '°C',
                  (l.brix !== '' && l.brix != null) && '당도 ' + l.brix + '°Bx',
                  (l.ph !== '' && l.ph != null) && 'pH ' + l.ph,
                  l.stir && '🥄 교반'
                ].filter(Boolean).join(' · ')}
              </div>
              <div>${esc(l.note)}</div>
            </div>
          `;
        }).join('') : '<div class="mute" style="margin-top:8px">기록된 일지가 없습니다.</div>'}
      </div>
    `;
  }

  function render(){
    const a = $('#app');
    if(!a) return;

    if(view.page === 'list'){
      const batchCards = db.slice().sort((x, y) => y.id - x.id).map(b => {
        const last = (b.logs && b.logs.length) ? b.logs[b.logs.length - 1] : null;
        let badgeType = b.type;
        if(b.type !== '누룩'){
          const sc = b.stages ? b.stages.length : 0;
          badgeType = sc === 1 ? '단양주' : sc === 2 ? '이양주' : sc === 3 ? '삼양주' : `${sc}양주`;
        }
        return `
          <div class="card clickable" onclick="appGo('detail', ${b.id})">
            <div>
              <span class="tag" style="background:${b.type === '누룩' ? 'var(--c2)' : 'var(--acc)'}">${b.type}</span>
              <span class="tag" style="background:var(--c1)">${badgeType}</span>
              <span class="tag d">${esc(b.status)}</span>
              <span class="mute">D+${dayN(b.start)}</span>
            </div>
            <h3 style="margin:6px 0 2px">${esc(b.name)}</h3>
            <div class="mute">${brief(b)}</div>
            <div class="mute" style="margin-top:4px">
              ${last ? `최근: ${last.d} · 품온 ${last.temp}°C${last.hum ? `· 습도 ${last.hum}%` : (last.brix !== '' ? `· ${last.brix}°Bx` : '')}` : '측정 데이터 없음'}
            </div>
          </div>
        `;
      }).join('');

      a.innerHTML = `
        <h1>🍶 미미록 (味美錄)</h1>
        <div class="sub">전통주 주방문 & 누룩 발효 기록장</div>
        <button type="button" class="p" style="width:100%;margin:12px 0" onclick="appGo('new')">+ 새 배치 등록</button>
        ${batchCards}
      `;
    } 
    else if(view.page === 'new'){
      a.innerHTML = `
        <button type="button" class="g" onclick="appGo('list')">← 목록으로</button>
        <h1>새 배치 만들기</h1>
        <div class="card">
          <label>종류 선택</label>
          <select id="f_type">
            <option value="막걸리">전통주 (막걸리/약주/탁주 덧술 배합비)</option>
            <option value="누룩">전통 누룩 (반죽 목표량 역산 계산기 / 온·습도 일지)</option>
          </select>
          <label>배치명</label>
          <input id="f_name" placeholder="예: 찰흑미 삼양주 또는 통밀 향온곡 3호">
          <label>시작일자</label>
          <input id="f_start" type="date" value="${today()}">
          <button type="button" class="p" style="width:100%;margin-top:14px" onclick="appAddBatch()">생성 및 시작</button>
        </div>
      `;
    } 
    else {
      const b = cur();
      if(!b) return appGo('list');
      const isNuruk = b.type === '누룩';

      a.innerHTML = `
        <div class="no-print" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <button type="button" class="g" onclick="appGo('list')">← 목록</button>
          <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end">
            <button type="button" class="share-btn" onclick="appShareOrSave()">📤 카톡/저장</button>
            <button type="button" class="download-btn" onclick="appExportCSV()">📊 CSV</button>
            <button type="button" class="download-btn" onclick="appPrintPDF()">📄 PDF</button>
          </div>
        </div>

        <div style="margin-top:4px">
          <span class="tag" style="background:${isNuruk ? 'var(--c2)' : 'var(--acc)'}">${b.type}</span>
          <span class="mute">시작일 ${b.start} (D+${dayN(b.start)})</span>
        </div>
        <h1 style="margin:4px 0">${esc(b.name)}</h1>
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px">
          <label style="margin:0;font-size:13px">진행 상태:</label>
          <select class="no-print" onchange="appSetStatus(this.value)" style="width:auto;padding:4px 8px">
            ${['발효중','숙성중','건조중','완료','실패'].map(s => `<option ${s === b.status ? 'selected' : ''}>${s}</option>`).join('')}
          </select>
        </div>

        <div class="tabs no-print">
          <button type="button" class="${view.tab === 'recipe' ? 'on' : ''}" onclick="appTab('recipe')">${isNuruk ? '🧮 누룩 역산 계산기' : '📖 배합비 & 덧술'}</button>
          <button type="button" class="${view.tab === 'journal' ? 'on' : ''}" onclick="appTab('journal')">${isNuruk ? '🌡 온·습도·환기 일지' : '📝 발효 일지'}</button>
        </div>

        ${view.tab === 'recipe' 
          ? (isNuruk ? nurukRecipeView(b) : wineRecipeView(b)) 
          : (isNuruk ? nurukJournalView(b) : wineJournalView(b))}
        
        <div class="no-print" style="text-align:right;margin-top:10px">
          <button type="button" class="g" style="color:#d9534f" onclick="appDelBatch()">이 배치 영구 삭제</button>
        </div>
      `;
    }
  }

  /* 전역 이벤트 바인딩 */
  window.appGo = (page, id) => {
    view.page = page;
    view.id = id || null;
    view.tab = 'recipe';
    view.chartFilter = 'all';
    render();
  };

  window.appTab = t => {
    view.tab = t;
    render();
  };

  window.appSetChartFilter = filterKey => {
    view.chartFilter = filterKey;
    render();
  };

  window.appAddBatch = () => {
    const name = v('f_name').trim();
    if(!name) return alert('배치명을 입력해 주세요.');
    const newId = Date.now();
    const type = v('f_type');
    const startDate = v('f_start') || today();

    if(type === '누룩'){
      db.push({
        id: newId,
        type: '누룩',
        name: name,
        start: startDate,
        status: '발효중',
        targetDough: 1000,
        lossRate: 10,
        moldingNote: '',
        recipeItems: [
          { cat: 'grain', name: '통밀가루', pct: 100 },
          { cat: 'water', name: '반죽 생수', pct: 25 }
        ],
        logs: []
      });
    } else {
      db.push({
        id: newId,
        type: type,
        name: name,
        start: startDate,
        status: '발효중',
        target: { nurukRatio: 10.0, waterRatio: 100.0 },
        stages: [{ name: '밑술 (1단계)', date: startDate, items: [], note: '' }],
        logs: []
      });
    }
    save();
    window.appGo('detail', newId);
  };

  window.appUpdateNurukTarget = () => {
    const b = cur();
    b.targetDough = +v('nk_target_dough') || 1000;
    b.lossRate = v('nk_loss_rate') !== '' ? +v('nk_loss_rate') : 10;
    save();
    render();
  };

  window.appAddNurukRecipeItem = () => {
    const cat = v('nk_cat');
    const name = v('nk_name').trim();
    const pct = +v('nk_pct');
    if(!name || isNaN(pct) || pct <= 0) return alert('재료 이름과 투입 비율(%)을 올바르게 입력해 주세요.');

    const b = cur();
    if(!b.recipeItems) b.recipeItems = [];
    b.recipeItems.push({ cat, name, pct });
    save();
    render();
  };

  window.appDelNurukItem = idx => {
    cur().recipeItems.splice(idx, 1);
    save();
    render();
  };

  window.appSaveMoldingNote = () => {
    cur().moldingNote = v('nk_molding');
    save();
    alert('성형 및 디딤 메모가 저장되었습니다.');
  };

  window.appHandleImgUpload = event => {
    const file = event.target.files[0];
    if(!file) return;

    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const maxW = 800;
        const scale = img.width > maxW ? maxW / img.width : 1;
        canvas.width = img.width * scale;
        canvas.height = img.height * scale;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.7);
        $('#l_img_data').value = dataUrl;
        $('#img_preview_box').innerHTML = `<img src="${dataUrl}" class="log-img">`;
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  };

  window.appAddNurukLog = () => {
    const b = cur();
    const dVal = v('l_d');
    if(!dVal) return alert('측정일을 입력해 주세요.');

    b.logs = (b.logs || []).filter(l => l.d !== dVal);
    b.logs.push({
      d: dVal,
      temp: v('l_temp'),
      room: v('l_room'),
      hum: v('l_hum'),
      vent: $('#l_vent') ? $('#l_vent').checked : false,
      img: v('l_img_data') || '',
      note: v('l_note')
    });
    b.logs.sort((x, y) => x.d.localeCompare(y.d));
    save();
    render();
  };

  window.appEditNurukLog = d => {
    const b = cur();
    const targetLog = (b.logs || []).find(l => l.d === d);
    if(!targetLog) return;

    if($('#l_d')) $('#l_d').value = targetLog.d;
    if($('#l_temp')) $('#l_temp').value = targetLog.temp;
    if($('#l_room')) $('#l_room').value = targetLog.room;
    if($('#l_hum')) $('#l_hum').value = targetLog.hum || '';
    if($('#l_vent')) $('#l_vent').checked = !!targetLog.vent;
    if($('#l_note')) $('#l_note').value = targetLog.note || '';
    if($('#l_img_data')) $('#l_img_data').value = targetLog.img || '';
    if($('#img_preview_box')){
      $('#img_preview_box').innerHTML = targetLog.img ? `<img src="${targetLog.img}" class="log-img">` : '';
    }

    const inputCard = $('#log-input-card');
    if(inputCard) inputCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  window.appSaveTarget = () => {
    const b = cur();
    b.target = { nurukRatio: +v('t_nr') || 0, waterRatio: +v('t_wr') || 0 };
    save();
    alert('목표 배합 비율이 저장되었습니다.');
    render();
  };

  window.appAddStage = () => {
    const b = cur();
    if(!b.stages) b.stages = [];
    const count = b.stages.length;
    const stageTitle = count === 0 ? '밑술 (1단계)' : `${count}차 덧술 (${count + 1}단계)`;
    b.stages.push({ name: stageTitle, date: today(), items: [], note: '' });
    save();
    render();
  };

  window.appSetStageDate = (sIdx, newDate) => {
    const b = cur();
    b.stages[sIdx].date = newDate;
    if(sIdx === 0) b.start = newDate;
    save();
    render();
  };

  window.appDelStage = sIdx => {
    if(confirm('단계를 삭제하시겠습니까?')){
      cur().stages.splice(sIdx, 1);
      save();
      render();
    }
  };

  window.appAddStageItem = sIdx => {
    const cat = v('stg_cat_' + sIdx);
    const name = v('stg_name_' + sIdx).trim();
    const amt = +v('stg_amt_' + sIdx);
    if(!name || !amt) return alert('원료 이름과 무게(g)를 입력해 주세요.');
    cur().stages[sIdx].items.push(it(cat, name, amt));
    save();
    render();
  };

  window.appDelStageItem = (sIdx, iIdx) => {
    cur().stages[sIdx].items.splice(iIdx, 1);
    save();
    render();
  };

  window.appSaveStageNote = sIdx => {
    cur().stages[sIdx].note = v('stg_note_' + sIdx);
    save();
    alert('해당 단계의 비고가 저장되었습니다.');
  };

  window.appAddWineLog = () => {
    const b = cur();
    const dVal = v('l_d');
    if(!dVal) return alert('날짜를 입력해 주세요.');
    
    b.logs = (b.logs || []).filter(l => l.d !== dVal);
    b.logs.push({
      d: dVal,
      temp: v('l_temp'),
      room: v('l_room'),
      brix: v('l_brix'),
      ph: v('l_ph'),
      stir: $('#l_stir') ? $('#l_stir').checked : false,
      note: v('l_note')
    });
    b.logs.sort((x, y) => x.d.localeCompare(y.d));
    save();
    render();
  };

  window.appEditWineLog = d => {
    const b = cur();
    const targetLog = (b.logs || []).find(l => l.d === d);
    if(!targetLog) return;

    if($('#l_d')) $('#l_d').value = targetLog.d;
    if($('#l_temp')) $('#l_temp').value = targetLog.temp;
    if($('#l_room')) $('#l_room').value = targetLog.room;
    if($('#l_brix')) $('#l_brix').value = targetLog.brix;
    if($('#l_ph')) $('#l_ph').value = targetLog.ph;
    if($('#l_note')) $('#l_note').value = targetLog.note || '';
    if($('#l_stir')) $('#l_stir').checked = !!targetLog.stir;

    const inputCard = $('#log-input-card');
    if(inputCard) inputCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  window.appDelLog = d => {
    if(confirm(`${d} 기록을 삭제하시겠습니까?`)){
      const b = cur();
      b.logs = (b.logs || []).filter(l => l.d !== d);
      save();
      render();
    }
  };

  window.appSetStatus = s => {
    cur().status = s;
    save();
    render();
  };

  window.appDelBatch = () => {
    if(confirm('이 배치와 관련된 모든 기록이 삭제됩니다. 계속하시겠습니까?')){
      db = db.filter(b => b.id !== view.id);
      save();
      window.appGo('list');
    }
  };

  function generateCSV(b){
    let csv = '\uFEFF';
    csv += `[기본 정보]\r\n배치명,${b.name}\r\n종류,${b.type}\r\n시작일,${b.start}\r\n상태,${b.status}\r\n\r\n`;

    if(b.type === '누룩'){
      const calc = calcNuruk(b);
      csv += `[성형 및 디딤 메모]\r\n"${(b.moldingNote||'').replace(/"/g, '""')}"\r\n\r\n`;
      csv += `[반죽 목표 설정]\r\n목표 반죽량,${calc.targetDough}g\r\n손실률,${calc.lossRate}%\r\n실제 제조량,${calc.reqDough}g\r\n\r\n`;
      csv += `[원료 배합 계산 결과]\r\n분류,원료명,투입비율(%),실제 계량치(g)\r\n`;
      calc.calculatedGrains.forEach(g => { csv += `"곡물","${g.name}",${g.pct}%,${g.amt.toFixed(1)}g\r\n`; });
      calc.calculatedWaters.forEach(w => { csv += `"물","${w.name}",${w.pct}%,${w.amt.toFixed(1)}g\r\n`; });
      calc.calculatedExtras.forEach(e => { csv += `"부재료","${e.name}",${e.pct}%,${e.amt.toFixed(1)}g\r\n`; });
      csv += `\r\n[누룩 띄우기 일지]\r\n측정일,경과일,품온(°C),실온(°C),습도(%),환기여부,비고\r\n`;
      (b.logs || []).forEach(l => {
        csv += `"${l.d}","D+${dayN(b.start, l.d)}",${l.temp||''},${l.room||''},${l.hum||''},"${l.vent?'환기함':''}", "${(l.note||'').replace(/"/g, '""')}"\r\n`;
      });
    } else {
      const g = tot(b, 'grain');
      csv += `[누적 배합비]\r\n곡물,${g}g,100%\r\n누룩,${tot(b,'nuruk')}g,${g?(tot(b,'nuruk')/g*100).toFixed(1):0}%\r\n물,${tot(b,'water')}g,${g?(tot(b,'water')/g*100).toFixed(1):0}%\r\n\r\n`;
      csv += `[발효 추적 일지]\r\n측정일,경과일,품온(°C),실온(°C),당도(Brix),pH,교반,비고\r\n`;
      (b.logs || []).forEach(l => {
        csv += `"${l.d}","D+${dayN(b.start, l.d)}",${l.temp||''},${l.room||''},${l.brix||''},${l.ph||''},"${l.stir?'교반함':''}", "${(l.note||'').replace(/"/g, '""')}"\r\n`;
      });
    }
    return csv;
  }

  window.appShareOrSave = async () => {
    const b = cur();
    if(!b) return;
    const csvContent = generateCSV(b);
    const file = new File([csvContent], `${b.name}_일지_${today()}.csv`, { type: 'text/csv;charset=utf-8' });
    if(navigator.canShare && navigator.canShare({ files: [file] })){
      try {
        await navigator.share({ title: b.name, text: `${b.name} 일지 파일입니다.`, files: [file] });
      } catch(e){}
    } else {
      window.appExportCSV();
    }
  };

  window.appExportCSV = () => {
    const b = cur();
    if(!b) return;
    const blob = new Blob([generateCSV(b)], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `${b.name}_일지_${today()}.csv`;
    link.click();
  };

  window.appPrintPDF = () => window.print();

  render();
})();
</script>
</body>
</html>
